[Unit]
Description=Concierge WhatsApp orchestration daemon
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=concierge
Group=concierge
WorkingDirectory=/opt/concierge
Environment=CONCIERGE_HOME=/var/lib/concierge
Environment=MIX_ENV=prod
ExecStart=/opt/concierge/bin/concierged-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
